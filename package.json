{
  "name": "responsiveshot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:universal": "tauri build --target universal-apple-darwin --bundles app",
    "oco": "opencommit",
    "lloco": "OCO_AI_PROVIDER='ollama' opencommit",
    "release:patch": "changelogen --release --patch",
    "release:minor": "changelogen --release --minor",
    "release:major": "changelogen --release --major"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.24",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@unocss/preset-icons": "^66.7.5",
    "@unocss/preset-typography": "^66.7.5",
    "@unocss/preset-uno": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.3.0",
    "changelogen": "^0.6.2",
    "esbuild": "^0.27.4",
    "typescript": "~5.9.3",
    "unocss": "^66.7.5",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.7"
  },
  "changelog": {
    "types": {
      "feat": {
        "title": "🚀 新機能",
        "semver": "minor"
      },
      "fix": {
        "title": "🐛 バグ修正",
        "semver": "patch"
      },
      "perf": {
        "title": "⚡ パフォーマンスの向上",
        "semver": "patch"
      },
      "refactor": {
        "title": "♻️ リファクタリング",
        "semver": "patch"
      },
      "docs": {
        "title": "📖 ドキュメント"
      },
      "style": {
        "title": "🎨 コードスタイル"
      },
      "test": {
        "title": "✅ テストの追加・修正"
      },
      "ci": {
        "title": "🤖 CI関連"
      },
      "build": {
        "title": "📦 ビルド",
        "semver": "patch"
      },
      "chore": {
        "title": "🧹 ビルドプロセスまたは補助ツールの変更"
      },
      "config": {
        "title": "🔧 設定ファイル"
      },
      "package": {
        "title": "📦 パッケージ"
      }
    },
    "templates": {
      "commitMessage": "chore(release): 🏹v{{newVersion}}",
      "tagMessage": "v{{newVersion}}",
      "tagBody": "v{{newVersion}}"
    }
  }
}
